{
  "option": {
    "CommonBattle_SkipMode": {
      "type": "select",
      "label": "扫荡模式",
      "default_case": "CommonBattle_SkipMode_Multiply",
      "cases": [
        {
          "name": "CommonBattle_SkipMode_Multiply",
          "label": "倍化",
          "pipeline_override": {
            "CommonBattle_AdjustSkipSettings": {
              "attach": {
                "skip_mode": "multiply"
              }
            }
          }
        },
        {
          "name": "CommonBattle_SkipMode_Skip",
          "label": "扫荡",
          "pipeline_override": {
            "CommonBattle_AdjustSkipSettings": {
              "attach": {
                "skip_mode": "skip"
              }
            }
          }
        }
      ]
    },
    "CommonBattle_MaxSkipTimes": {
      "type": "select",
      "label": "限制最大扫荡次数",
      "description": "MaaAimisu会根据BP与该选项，计算出单次战斗的最大扫荡次数。",
      "default_case": "CommonBattle_MaxSkipTimes_9",
      "cases": [
        {
          "name": "CommonBattle_MaxSkipTimes_1",
          "label": "1",
          "pipeline_override": {
            "CommonBattle_AdjustSkipSettings": {
              "attach": {
