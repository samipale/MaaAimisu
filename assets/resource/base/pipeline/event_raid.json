{
  "RaidBattle_Entry": {
    "next": [
      "RaidBattle_Entry_AdjustInterface",
      "RaidBattle_RaidList",
      "RaidBattle_EventDifficultyList",
      "[JumpBack]CommonEvent_GoToDifficultyList"
    ],
    "timeout": 3000
  },
  "RaidBattle_Entry_AdjustInterface": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "Common_UIClose",
          "CommonBattle_RaidQuest_AdjustInterface"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "RaidBattle_RaidList"
    ]
  },
  "RaidBattle_RaidList": {
    "anchor": {
      "QuestList": "RaidBattle_RaidList",
      "BattleResult": "CommonBattle_Result_BackToQuestList"
    },
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": "raid/damage_point.png"
      }
    },
    "next": [
      "RaidBattle_ChooseDifficulty"
    ]
  },
  "RaidBattle_EventDifficultyList": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "SkipEvent_DifficultyList"
        ]
      }
    },
    "focus": {
      "Node.Recognition.Succeeded": "该活动是普通活动，请使用普通活动模块运行"
    }
  },
  "RaidBattle_ChooseDifficulty": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": "raid/difficulty_5.png"
      }
    },
    "next": [
      "[JumpBack]ChooseParty_ChooseParty",
      "CommonBattle_OpenRaidQuestSettings"
    ]
  }
}

