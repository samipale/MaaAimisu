{
  "SkipEvent_Entry": {
    "next": [
      "SkipEvent_Entry_AdjustInterface",
      "SkipEvent_DifficultyList",
      "SkipEvent_RaidInterface",
      "[JumpBack]CommonEvent_GoToDifficultyList"
    ]
  },
  "SkipEvent_Entry_AdjustInterface": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "Common_UIClose",
          "CommonBattle_ChooseMultiplyMode"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "SkipEvent_DifficultyList"
    ]
  },
  "SkipEvent_DifficultyList": {
    "anchor": {
      "QuestList": "SkipEvent_DifficultyList",
      "BattleResult": "CommonBattle_Result_BackToQuestList"
    },
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": "quest/event/event_exchange.png"
      }
    },
    "next": [
      "SkipEvent_ChooseClearedQuest",
      "SkipEvent_NoClearedQuest"
    ]
  },
  "SkipEvent_RaidInterface": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "RaidBattle_RaidList"
        ]
      }
    },
    "focus": {
      "Node.Recognition.Succeeded": "该活动是团队战，请使用团队战活动模块运行"
    }
  },
  "SkipEvent_NoClearedQuest": {
    "focus": {
      "Node.Recognition.Succeeded": "没有已通关的任务，无法扫荡，任务中止"
    }
  },
  "SkipEvent_ChooseClearedQuest": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": "quest/cleared_quest.png",
        "order_by": "Vertical"
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "SkipEvent_ChooseBonusQuest_AdjustSkipSettings"
    ]
  },
  "SkipEvent_ChooseClearedQuest": {
    "recognition": {
      "type": "Custom",
      "param": {
        "custom_recognition": "event_difficulty_recognition"
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "[JumpBack]ChooseParty_ChooseParty",
      "CommonBattle_SkipQuest"
    ],
    "attach": {
      "quest_type": "challenge",
      "quest_cleared": true,
      "quest_name": "1|3|5"
    }
  },
  }
}
